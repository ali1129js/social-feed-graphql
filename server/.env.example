# Copy to server/.env for local use. Never commit the real file (.env is git-ignored).
# The server reads plain environment variables; it does not load .env files itself.
# Use `node --env-file=.env` or export the variables in your shell.

# Optional. When set, the server uses Postgres. When empty or missing, it uses the
# in-memory store with the demo data (local dev, tests).
# Neon: copy the connection string from the Neon dashboard (it ends in sslmode=require).
DATABASE_URL=

# Required in any real deployment. Any long random string.
JWT_SECRET=

# Optional, defaults to 4000.
PORT=4000
