{
  "name": "social-feed-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "guard": "node ../client/scripts/leak-guard.mjs . --exclude package-lock.json --exclude drizzle/meta/_journal.json --exclude drizzle/meta/0000_snapshot.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.16.0",
    "jose": "^6.2.18",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.1",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
